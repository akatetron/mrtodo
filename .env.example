# Copy to .env (never commit the real one). The two values marked PUBLIC are safe
# inside an app; everything marked SECRET belongs only in Supabase "Edge Function secrets".

# --- App (Expo) and admin dashboard (Vite): PUBLIC -------------------------------
# Set in app/src/lib/supabase.js and admin/src/lib/supabase.js (or admin/.env as VITE_*)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Edge Functions: SECRET (supabase secrets set NAME=value) --------------------
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions by Supabase.
# The service-role key must never be put in an app, the dashboard, or this repository.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
