{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2020", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": false, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true, "allowJs": false,
    "types": ["vite/client"], "isolatedModules": true, "resolveJsonModule": true
  },
  "include": ["src"]
}
