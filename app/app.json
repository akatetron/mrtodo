{
  "expo": {
    "name": "Mr. Todo",
    "slug": "mr-todo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mrtodo.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Mr. Todo uses your photos so you can upload ID and qualification documents.",
        "NSLocationWhenInUseUsageDescription": "Mr. Todo uses your location once, only when you tap the button, to help match nearby Personal Managers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123B3F"
      },
      "package": "com.mrtodo.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Mr. Todo",
      "themeColor": "#123B3F"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#123B3F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mr. Todo uses your location once, only when you tap the button, to help match nearby Personal Managers."
        }
      ]
    ]
  }
}